<a href="/suppliers" class="btn-back">← Back to Suppliers</a>

<div class="form-container">
  <% if (errors && errors.length > 0) { %>
    <div class="alert alert-error">
      <ul class="error-list">
        <% errors.forEach(e => { %><li><%= e %></li><% }) %>
      </ul>
    </div>
  <% } %>

  <div class="form-card">
    <form action="/suppliers/<%= supplier ? supplier.id : '' %>" method="POST">
      <div class="form-group">
        <label class="form-label" for="name">Supplier Name <span class="required">*</span></label>
        <input type="text" id="name" name="name" class="form-input"
          value="<%= supplier ? supplier.name : '' %>" placeholder="e.g. Ethiopian Highlands Co." required>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="country">Country</label>
          <input type="text" id="country" name="country" class="form-input"
            value="<%= supplier ? (supplier.country || '') : '' %>" placeholder="e.g. Ethiopia">
        </div>
        <div class="form-group">
          <label class="form-label" for="contact_email">Contact Email</label>
          <input type="email" id="contact_email" name="contact_email" class="form-input"
            value="<%= supplier ? (supplier.contact_email || '') : '' %>" placeholder="contact@supplier.com">
        </div>
      </div>
      <% if (supplier && supplier.id) { %>
        <div class="admin-section">
          <div class="admin-label">Admin Authorization Required</div>
          <div class="form-group">
            <label class="form-label" for="admin_password">Admin Password <span class="required">*</span></label>
            <input type="password" id="admin_password" name="admin_password" class="form-input"
              placeholder="Enter admin password to save changes" required>
          </div>
        </div>
      <% } %>
      <button type="submit" class="btn-submit">
        <%= supplier && supplier.id ? 'Save Changes' : 'Add Supplier' %>
      </button>
    </form>
  </div>
</div>