<a href="/categories" class="btn-back">← Back to Categories</a>

<% if (locals.query && query.error === 'has_items') { %>
  <div class="alert alert-warning">⚠ Cannot delete a category that still has items. Reassign or delete them first.</div>
<% } %>
<% if (locals.query && query.error === 'wrong_password') { %>
  <div class="alert alert-error">✗ Incorrect admin password.</div>
<% } %>

<div class="detail-layout">
  <div>
    <div class="detail-card" style="margin-bottom:24px;">
      <div class="detail-header">
        <h2><%= category.name %></h2>
        <% if (category.description) { %><p><%= category.description %></p><% } %>
      </div>
      <div class="detail-body">
        <div class="field-list">
          <div class="field-item">
            <div class="field-label">Items</div>
            <div class="field-value"><%= items.length %> item<%= items.length !== 1 ? 's' : '' %> in this category</div>
          </div>
          <div class="field-item">
            <div class="field-label">Created</div>
            <div class="field-value"><%= new Date(category.created_at).toLocaleDateString('en-US', { year:'numeric', month:'long', day:'numeric' }) %></div>
          </div>
        </div>
      </div>
    </div>

    <div class="section-header">
      <span class="section-title">Items in <%= category.name %></span>
      <a href="/items/new" class="section-link">+ Add Item</a>
    </div>

    <% if (items.length === 0) { %>
      <div class="table-wrap">
        <div class="empty-state">
          <div class="empty-icon">◉</div>
          <p>No items in this category. <a href="/items/new">Add one.</a></p>
        </div>
      </div>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Name</th><th>Quantity</th><th>Price</th><th>Supplier</th><th>Status</th></tr>
          </thead>
          <tbody>
            <% items.forEach(item => { %>
              <tr>
                <td><a href="/items/<%= item.id %>"><%= item.name %></a></td>
                <td><%= parseFloat(item.quantity) %> <%= item.unit %></td>
                <td>$<%= parseFloat(item.price).toFixed(2) %></td>
                <td><%= item.supplier_name || '—' %></td>
                <td>
                  <% if (parseFloat(item.quantity) <= parseFloat(item.low_stock_threshold)) { %>
                    <span class="tag badge-low">Low Stock</span>
                  <% } else { %>
                    <span class="tag">OK</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <div class="action-panel">
    <h3>Actions</h3>
    <a href="/categories/<%= category.id %>/edit" class="btn btn-primary">Edit Category</a>
    <a href="/items/new" class="btn btn-outline">Add Item Here</a>
    <div style="margin-top:16px;padding-top:16px;border-top:1px solid var(--border);">
      <button onclick="document.getElementById('deleteModal').classList.add('open')" class="btn btn-danger">Delete Category</button>
    </div>
  </div>
</div>

<div class="modal-overlay" id="deleteModal">
  <div class="modal">
    <h3>Delete Category</h3>
    <p>This action requires admin authorization. Categories with items cannot be deleted.</p>
    <form action="/categories/<%= category.id %>/delete" method="POST">
      <div class="form-group">
        <label class="form-label">Admin Password <span class="required">*</span></label>
        <input type="password" name="admin_password" class="form-input" placeholder="Enter admin password" required>
      </div>
      <div class="modal-actions">
        <button type="button" class="btn-cancel" onclick="document.getElementById('deleteModal').classList.remove('open')">Cancel</button>
        <button type="submit" class="btn btn-submit btn-submit-danger" style="width:auto;padding:9px 20px;">Delete</button>
      </div>
    </form>
  </div>
</div>