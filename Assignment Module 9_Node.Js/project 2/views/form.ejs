<h1>New Message</h1>

<form method="POST" action="/new">
  <label for="messageUser">Your Name:</label>
  <input type="text" id="messageUser" name="messageUser" required><br><br>

  <label for="messageText">Message:</label>
  <textarea id="messageText" name="messageText" required></textarea><br><br>

  <input type="submit" value="Submit">
</form>